---
const currentYear = new Date().getFullYear();
---

<footer class="footer-wrapper">
  <div class="container footer-container">
    <div class="status-left mono">
      <span class="indicator"></span> SLADE_ROSE // STATUS: NOMINAL
    </div>
    <div class="status-right mono">
      &copy; {currentYear} SLADE_ROSE
    </div>
  </div>
</footer>

<style>
  .footer-wrapper {
    background: var(--color-bg-base);
    border-top: 1px solid var(--color-border-grid);
    padding: 0.75rem 0;
    min-height: 4.5rem; /* Standardized height with Navbar */
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1000;
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .footer-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .indicator {
    width: 8px;
    height: 8px;
    background: var(--color-accent-green);
    display: inline-block;
    margin-right: 0.75rem;
    vertical-align: middle;
  }
  @media (max-width: 768px) {
    .footer-container {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>

---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Slade Rose | Solution Architect"
  description="Slade Rose — Solution Architect and Development Lead at Athenium Consulting. SAP BTP ecosystems, Ruby on Rails, and radical simplicity."
  fullscreen
>
  <div class="grid-container">
    <!-- TILE 00: IDENTITY (2x2 HERO) -->
    <div class="tile tile-about tile-2x2" style="--delay: 3">
      <div class="card-meta mono">OPERATIONAL_PROTOCOL // 00.1</div>
      <h1>Slade <span class="accent">Rose /</span></h1>
      <p>I'm a Solution Architect and Development Lead at Athenium Consulting in KZN, South Africa. I specialize in architecting complex, large-scale SAP BTP ecosystems for the energy sector.</p>
      <p style="margin-top: 1rem;">While my professional world revolves around robust enterprise frameworks like SAP CAP and SAPUI5, my personal philosophy leans toward radical simplicity. I'm currently exploring the 37signals philosophy—leveraging Ruby on Rails and Hotwire to build fast, resilient web applications with as little JavaScript as possible.</p>
      <p style="margin-top: 1rem;">When I'm AFK, you'll find me surfing or running.</p>
      <div class="tile-status mono">STATUS // ACTIVE_NODE_734</div>
    </div>

    <!-- TILE 01: BUILD (PORTAL) -->
    <a href="/build" class="tile tile-category" style="--delay: 1">
      <div class="card-meta mono">VECTORS // 01.1</div>
      <h2>/build</h2>
      <p>A curated mosaic of public code, enterprise architecture, and digital engineering.</p>
      <div class="tile-status mono">MOSAIC_VIEW // 05_REPOS</div>
    </a>

    <!-- TILE 02: LENS (PORTAL) -->
    <a href="/lens" class="tile tile-category" style="--delay: 4">
      <div class="card-meta mono">SENSORS // 02.1</div>
      <h2>/lens</h2>
      <p>Capturing the elements. A visual log of surfing the KZN coast and trail running.</p>
      <div class="tile-status mono">LOC // KZN_SOUTH_AFRICA</div>
    </a>

    <!-- TILE 03: LOGIC (PHILOSOPHY) -->
    <a href="/logic" class="tile tile-category" style="--delay: 0">
      <div class="card-meta mono">LOGIC // 03.1</div>
      <h2>/logic</h2>
      <p>Radical simplicity. 37signals philosophy. Building fast, resilient systems with zero waste.</p>
      <div class="tile-status mono">MODE // OPTIMIZED</div>
    </a>

    <!-- TILE 04: UPLINK (CONNECT) -->
    <div class="tile tile-category" style="--delay: 2">
      <div class="card-meta mono">INTERFACE // 04.1</div>
      <h2>/connect</h2>
      <p>Initialize communications for professional consultation or technical collaboration.</p>
      <div class="project-langs">
        <a href="https://linkedin.com/in/sladerose" target="_blank" class="accent mono" style="font-size: 0.65rem; font-weight: 700;">LINKEDIN_UPLINK</a>
        <a href="https://github.com/sladerose" target="_blank" class="accent mono" style="font-size: 0.65rem; font-weight: 700;">GITHUB_ROOT</a>
        <a href="mailto:sladerose1@gmail.com" class="accent mono" style="font-size: 0.65rem; font-weight: 700;">EMAIL_DIRECT</a>
      </div>
      <div class="tile-status mono">SIGNAL // SECURE_SYNC</div>
    </div>
  </div>
</Layout>
